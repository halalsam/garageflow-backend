# --- Database -------------------------------------------------------------
# Keep host port in sync with docker-compose.yml (5434 to avoid clashing with a
# local Postgres on 5432/5433).
DATABASE_URL="postgresql://garageflow:garageflow@localhost:5434/garageflow?schema=public"

# --- Auth -----------------------------------------------------------------
# Use long random strings in production (e.g. `openssl rand -base64 48`).
JWT_ACCESS_SECRET="dev-access-secret-change-me"
JWT_REFRESH_SECRET="dev-refresh-secret-change-me"
JWT_ACCESS_TTL="15m"
JWT_REFRESH_TTL="30d"

# --- Server ---------------------------------------------------------------
PORT=3000
# Public base URL used to build absolute /uploads file URLs.
PUBLIC_URL="http://localhost:3000"
